<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- AI Log — Form View                                            -->
    <!-- ============================================================ -->
    <record id="view_ai_log_form" model="ir.ui.view">
        <field name="name">ai.log.form</field>
        <field name="model">os.ai.log</field>
        <field name="arch" type="xml">
            <form string="AI Log" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1 invisible="not model_name">
                            <field name="model_name" readonly="1"/>
                            <span> / </span>
                            <field name="field_name" readonly="1"/>
                        </h1>
                        <h1 invisible="model_name or not feature_type">
                            <field name="feature_type" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Context">
                            <field name="feature_id" invisible="not feature_id"/>
                            <field name="feature_type" invisible="not feature_type"/>
                            <field name="model_name" invisible="not model_name"/>
                            <field name="field_name" invisible="not field_name"/>
                            <field name="res_ids" invisible="not res_ids"/>
                            <field name="batch_size" invisible="not batch_size"/>
                            <field name="provider_id"/>
                            <field name="provider_model"/>
                            <field name="request_uid" invisible="not request_uid"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Result &amp; Routing">
                            <field name="success"/>
                            <field name="duration"/>
                            <field name="complexity" invisible="not complexity"/>
                            <field name="complexity_score" invisible="not complexity_score"/>
                            <field name="attempt_number" invisible="not feature_type"/>
                            <field name="is_fallback" invisible="not is_fallback"/>
                            <field name="fallback_reason" invisible="not is_fallback"/>
                            <field name="prompt_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="total_tokens"/>
                            <field name="response_cost"/>
                            <field name="cost_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="System Prompt" name="system_prompt">
                            <field name="system_prompt" readonly="1"/>
                        </page>
                        <page string="User Prompt" name="user_prompt">
                            <field name="user_prompt" readonly="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_content" readonly="1"/>
                        </page>
                        <page string="Error" name="error" invisible="success">
                            <field name="error_message" readonly="1"/>
                        </page>
                        <page string="Request Context" name="request_context" invisible="not request_context">
                            <field name="request_context" readonly="1"/>
                        </page>
                        <page string="Raw Response" name="raw">
                            <field name="response_raw" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Log — Tree / List View                                     -->
    <!-- ============================================================ -->
    <record id="view_ai_log_tree" model="ir.ui.view">
        <field name="name">ai.log.tree</field>
        <field name="model">os.ai.log</field>
        <field name="arch" type="xml">
            <list string="AI Logs" create="0" edit="0"
                  decoration-danger="not success"
                  decoration-success="success">
                <field name="create_date"/>
                <field name="feature_type" optional="show"/>
                <field name="complexity" optional="show"/>
                <field name="is_fallback" optional="show"/>
                <field name="model_name" optional="show"/>
                <field name="field_name" optional="show"/>
                <field name="batch_size" optional="hide"/>
                <field name="provider_id"/>
                <field name="provider_model"/>
                <field name="success"/>
                <field name="total_tokens"/>
                <field name="response_cost" sum="Total Cost"/>
                <field name="cost_status" optional="hide"/>
                <field name="duration" sum="Total Duration"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Log — Search View                                          -->
    <!-- ============================================================ -->
    <record id="view_ai_log_search" model="ir.ui.view">
        <field name="name">ai.log.search</field>
        <field name="model">os.ai.log</field>
        <field name="arch" type="xml">
            <search string="Search AI Logs">
                <field name="feature_type"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="provider_id"/>
                <field name="provider_model"/>
                <filter string="Successful" name="success" domain="[('success', '=', True)]"/>
                <filter string="Failed" name="failed" domain="[('success', '=', False)]"/>
                <separator/>
                <filter string="Fallback Attempts" name="fallback" domain="[('is_fallback', '=', True)]"/>
                <separator/>
                <filter string="Low Complexity" name="complexity_low" domain="[('complexity', '=', 'low')]"/>
                <filter string="Medium Complexity" name="complexity_medium" domain="[('complexity', '=', 'medium')]"/>
                <filter string="High Complexity" name="complexity_high" domain="[('complexity', '=', 'high')]"/>
                <group expand="0" string="Group By">
                    <filter string="Feature" name="group_feature" context="{'group_by': 'feature_type'}"/>
                    <filter string="Complexity" name="group_complexity" context="{'group_by': 'complexity'}"/>
                    <filter string="Provider" name="group_provider" context="{'group_by': 'provider_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'provider_model'}"/>
                    <filter string="Status" name="group_success" context="{'group_by': 'success'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Log — Action                                               -->
    <!-- ============================================================ -->
    <record id="action_ai_log" model="ir.actions.act_window">
        <field name="name">AI Logs</field>
        <field name="res_model">os.ai.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI logs yet
            </p>
            <p>
                Every LLM call made by the AI Gateway or AI Fields is recorded here
                with full details: prompts, tokens, cost, complexity, and routing response.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu Item                                                     -->
    <!-- ============================================================ -->
    <menuitem id="menu_ai_log"
              name="AI Logs"
              parent="menu_os_ai_root"
              action="action_ai_log"
              sequence="30"/>

</odoo>
